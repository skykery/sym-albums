# Path on the homeserver where your original photo collection lives.
# Mounted read-only inside the container at /photos.
PHOTOS_ROOT=/mnt/photos

# Where symlink albums should be written on the homeserver.
# Mounted read-write inside the container at /albums.
ALBUMS_ROOT=/mnt/albums

# Optional
PORT=3000
TZ=UTC
LOG_LEVEL=info
THUMB_CONCURRENCY=8
